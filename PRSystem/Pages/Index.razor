    private double ItemsGrossPrice(PurchaseRequestLine line)
    {
        var discountAmount = line.UnitPrice * (line.DiscountPercent / 100); // Calculate discount amount
        var discountedPrice = line.UnitPrice - discountAmount;             // Subtract discount from unit price
        var grossPrice = line.Quantity * discountedPrice;                  // Calculate gross price
        return Math.Round(grossPrice, 2);                          // Calculate gross price
    }

    private double ServiceGrossPrice(PurchaseRequestLine line)
    {
        var discountAmount = line.UnitPrice * (line.DiscountPercent / 100);
        var grossPrice = line.UnitPrice - discountAmount;
        return Math.Round(grossPrice, 2);
    }

