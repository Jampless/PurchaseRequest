    private void OnSearchItemCode(PurchaseRequestLine line, ChangeEventArgs e)
    {
        var searchText = e.Value?.ToString()?.ToLower();

        if (!string.IsNullOrEmpty(searchText))
        {
            line.FilteredItemsCode = oItems
                .Where(item => item.ItemCode.ToLower().Contains(searchText))
                .ToList();

            line.ItemSearchTextCode = searchText;

        }
        else
        {
            line.FilteredItemsCode = oItems?.ToList();
            line.ItemSearchTextCode = string.Empty;

            // Clear the ItemCode field
            line.ItemCode = string.Empty;
            line.ItemDescription = string.Empty;
            line.Size = string.Empty;
            line.Color = string.Empty;
            line.UoMCode = string.Empty;
        }

        StateHasChanged();
    }
