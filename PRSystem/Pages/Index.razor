    public async Task SubmitPurchaseRequest()
    {
        await loginFunction();

        var u_department = r_department switch
        { 2 => "MDSE", 3 => "SALES", 5 => "OPS", 6 => "MIS", 7 => "FINANCE", 8 => "MKTG", 9 => "SALESMKTG", 
            10 => "PRES", 11 => "PURCHASE", 12 => "FINANCE_AUDIT", 13 => "HR", 14 => "BP", _=>null };

        Console.WriteLine($"PR Submit");
        // Create the PurchaseRequest object with data from your form or database

        var purchaseRequest = new PurchaseRequest // if docType == "dDocument_Items"
            {
                DocType = docType,
                DocDate = postingDate.ToString("yyyy-MM-dd"),
                DocDueDate = validUntil.ToString("yyyy-MM-dd"),
                RequriedDate = requiredDate.ToString("yyyy-MM-dd"),
                Requester = "z_Direc1", 
                RequesterName = requester,
                RequesterDepartment = r_department,
                U_Department = u_department,
                U_Remarks = remarks,
                U_TransactionType = transactionType,
                U_PrepBy = requester,
                U_CompanyTIN = company, 
                DocumentLines = docType == "dDocument_Items"
                    ? documentLines.Select(line => new PurchaseRequestLine
                    {
                        ItemCode = line.ItemCode,
                        UoMCode = line.UoMCode,
                        Quantity = line.Quantity,
                        UnitPrice = line.UnitPrice,
                        DiscountPercent = line.DiscountPercent,
                        VatGroup = line.VatGroup,
                        U_PreferredSupplier = line.U_PreferredSupplier,
                        RequiredDate = requiredDate.ToString("yyyy-MM-dd"),
                        CostingCode = u_department
                    }).ToList()
                    : documentLines.Select(line => new PurchaseRequestLine
                    {
                        AccountCode = line.AccountCode,
                        ItemDescription = line.ItemDescription,
                        UnitPrice = line.UnitPrice,
                        DiscountPercent = line.DiscountPercent,
                        VatGroup = line.VatGroup,
                        U_PreferredSupplier = line.U_PreferredSupplier,
                        RequiredDate = requiredDate.ToString("yyyy-MM-dd"),
                        CostingCode = u_department
                    }).ToList()
            };

        // Console.WriteLine(purchaseRequest);
        var option = new JsonSerializerOptions {
                WriteIndented = true,
                // DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            };
        string PRJSON = JsonSerializer.Serialize(purchaseRequest, option);

        @* Console.WriteLine(PRJSON); *@
        try{
            docNum = await SapService.PostPurchaseRequestAsync(purchaseRequest, sessionId);
            // await _runtime.InvokeVoidAsync("alert", $"Purchase Request Created with DocNum: {docNum}");
            Console.WriteLine($"PR Number: {docNum}");
            popupMessage = $"Purchase Request Created with DocNum: {docNum}";
            showPopup = true;
            
            @* _navigation.NavigateTo(NavigationManager.Uri, forceLoad: true); *@
        }
        catch(Exception ex){
            Console.WriteLine($"PR Error: {ex.Message}");
            var errorState = await SapService.PostPurchaseRequestAsync(purchaseRequest, sessionId);
            // await _runtime.InvokeVoidAsync("alert", $"Purchase Request has error {errorState}");
            popupMessage = $"Purchase Request has error: {errorState}";
            showPopup = true;
        }
        finally{
            await LogoutUser();
            sessionId = string.Empty;
        }
    }
