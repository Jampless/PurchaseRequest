    private List<OGLAccounts>? oGLAccounts = new List<OGLAccounts>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Retrieve sessionStorage values
            var sessionId = await _runtime.InvokeAsync<string>("sessionStorage.getItem", "session_id");
            Scompany = await _runtime.InvokeAsync<string>("sessionStorage.getItem", "company");
            SuserId = await _runtime.InvokeAsync<string>("sessionStorage.getItem", "username");
            Console.WriteLine("Company: " + Scompany);
            Console.WriteLine("User ID: " + SuserId);
            // Redirect if sessionId is null or empty
            if (string.IsNullOrEmpty(sessionId))
            {
                _navigation.NavigateTo("http://192.168.0.7:8484/", true);
                return;
            }

            // Configure the SAPOdbc instance dynamically based on the company
            _sap.Configure(
                server: "HANASERVERNBFI:30015",
                   user: "SYSTEM",
                   password: "Sb1@nbfi",
                   databaseNBFI: "Z_NBFI_SBOTEST",
                   databaseEPC: "Z_EPC_SBOTEST",
                company: Scompany
            );

            // // Set SAP properties
            // _sap.SAPCompany = Scompany;
            requester = SuserId;
            // Console.WriteLine("SAP.....COMNP: " + _sap.SAPCompany);

            if(_sap.SAPCompany != ""){
                // Load data after sessionStorage values are retrieved
                oItems = await Task.Run(() => _sap.GetItemAsync());
                oSuppliers = await Task.Run(() => _sap.GetSuppliers());
                oGLAccounts = await Task.Run(() => _sap.GetGLAccounts());
                oTaxCodes = await Task.Run(() => _sap.GetTaxCode());

            }



            StateHasChanged(); // Force re-render after data is loaded
        }
    }
    private async Task loginFunction()
    {
        string slCompany = "";

        if(Scompany == "EPC" || Scompany == "AHLC") slCompany = "Z_EPC_SBOTEST";
        else slCompany = "Z_NBFI_SBOTEST";

        var loginRequest = new LoginRequest
            {
                UserName = "z_Direc1",
                Password = "B1Admin",
                CompanyDB = slCompany
            };

        try
        {
            var loginResponse = await SapService.LoginAsync(loginRequest);
            sessionId = loginResponse.SessionId;
            loginMessage = "Login successful!";
            isLoggedIn = true;
            _navigation.NavigateTo($"/app4");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loginMessage = $"Login failed. Please check your username and password. {ex.Message}";
            // Log the exception details
        }
