    private List<PurchaseRequestLine> GenerateItemLines(){
        if(documentLines == null || !documentLines.Any()){
            Console.WriteLine("Document lines are empty!");
            return new List<PurchaseRequestLine>();
        }

        return documentLines.Select(line => new PurchaseRequestLine
            {
                ItemCode = line.ItemCode,
                UoMCode = line.UoMCode,
                Quantity = line.Quantity,
                UnitPrice = line.UnitPrice,
                DiscountPercent = line.DiscountPercent,
                VatGroup = line.VatGroup,
                U_PreferredSupplier = line.U_PreferredSupplier,
                RequiredDate = requiredDate.ToString("yyyy-MM-dd"),
                CostingCode = line.CostingCode
            }).ToList();
    }
    private List<PurchaseRequestLine> GenerateServiceLines()
    {
        if (documentLines == null || !documentLines.Any())
        {
            Console.WriteLine("Document lines are empty!");
            return new List<PurchaseRequestLine>();
        }

        return documentLines.Select(line => new PurchaseRequestLine
            {
                AccountCode = line.ItemCode,
                ItemDescription = line.ItemDescription,
                UnitPrice = line.UnitPrice,
                DiscountPercent = line.DiscountPercent,
                VatGroup = line.VatGroup,
                U_PreferredSupplier = line.U_PreferredSupplier,
                RequiredDate = requiredDate.ToString("yyyy-MM-dd"),
                CostingCode = line.CostingCode
            }).ToList();
    }

    private double TotalGrossPrice => documentLines.Sum(line => CalculateGrossPrice(line));

    private double CalculateGrossPrice(PurchaseRequestLine line)
    {
        if (docType == "dDocument_Items"){
            return ItemsGrossPrice(line);
        }
        else{
            return ServiceGrossPrice(line);
        }
    }
